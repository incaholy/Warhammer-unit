# Keep the build context small and secrets out of the image.
.git
.gitignore
.github

# Secrets / local env (config comes in at runtime, never baked in).
.env
.envrc

# Virtualenvs
.venv
venv/
env/
ENV/

# Caches / build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# Editor / OS
.vscode/
.idea/
.DS_Store

# Not needed at runtime (tests/ IS kept — docker-compose.test.yml runs pytest
# tests/ inside the image, and pytest ships in requirements.txt).
*.md
Dockerfile
.dockerignore
docker-compose*.yml
