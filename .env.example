# Copy to .env (which is gitignored) and fill in.

# Postgres connection (see `make db-setup`).
DATABASE_URL=postgresql+psycopg2://warhammer_unit_user:password@localhost:5432/warhammer_unit_dev

# App environment. "dev" (default) permits a throwaway JWT key when SECRET_KEY is
# unset; any other value REQUIRES SECRET_KEY (the app refuses to start otherwise).
APP_ENV=dev

# JWT signing key — generate a real random value for anything but local dev,
# e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required whenever APP_ENV != dev (and docker compose refuses to start without it).
SECRET_KEY=change-me

# Optional; access-token lifetime in minutes (default 2880 = 2 days).
ACCESS_TOKEN_EXPIRE_MINUTES=2880

# Optional; comma-separated allow-list of frontend origins for CORS (never "*").
# Only needed when the frontend is served from a different origin than the API.
# e.g. ALLOWED_ORIGINS=http://localhost:5173,https://muster.example.com
ALLOWED_ORIGINS=
