# Copy to .env (which is gitignored) and fill in.

# Postgres connection (see `make db-setup`).
DATABASE_URL=postgresql+psycopg2://warhammer_unit_user:password@localhost:5432/warhammer_unit_dev

# JWT signing key — generate a real random value for anything but local dev,
# e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Optional; access-token lifetime in minutes (default 2880 = 2 days).
ACCESS_TOKEN_EXPIRE_MINUTES=2880
