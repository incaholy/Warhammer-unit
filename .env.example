# Copy to .env (which is gitignored) and fill in.

# Postgres connection (see `make db-setup`).
DATABASE_URL=postgresql+psycopg2://warhammer_unit_user:password@localhost:5432/warhammer_unit_dev

# App environment. "dev" (default) permits a throwaway JWT key when SECRET_KEY is
# unset; any other value REQUIRES SECRET_KEY (the app refuses to start otherwise).
APP_ENV=dev

# JWT signing key — generate a real random value for anything but local dev,
# e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required whenever APP_ENV != dev (and docker compose refuses to start without it).
SECRET_KEY=change-me

# Optional; access-token lifetime in minutes (default 2880 = 2 days).
ACCESS_TOKEN_EXPIRE_MINUTES=2880

# Optional; comma-separated allow-list of frontend origins for CORS (never "*").
# Only needed when the frontend is served from a different origin than the API.
# e.g. ALLOWED_ORIGINS=http://localhost:5173,https://muster.example.com
ALLOWED_ORIGINS=

# Optional; error reporting (ROADMAP R7). Unset = disabled (a true no-op — nothing
# is sent, nothing needs mocking), which is right for local and CI. Set it in a
# real deployment to capture unhandled exceptions, each tagged with its request_id.
SENTRY_DSN=
# Optional; performance-trace sample rate for Sentry (0 = errors only, the default).
SENTRY_TRACES_SAMPLE_RATE=0

# Optional; log level for the app's JSON logger (default INFO).
LOG_LEVEL=INFO

# Optional; opt in to the Postgres parity test tier (ROADMAP R6). Unset, `pytest`
# uses fast in-memory SQLite. Set it and the suite runs against Postgres with the
# schema built by the real migrations. It DROPs and rebuilds the target schema, so
# it must be a THROWAWAY database — the name must contain "test" and must not be
# your DATABASE_URL, or the run refuses to start.
# e.g. TEST_DATABASE_URL=postgresql+psycopg2://localhost:5432/warhammer_unit_test
TEST_DATABASE_URL=
